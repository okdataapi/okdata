          "type": "string",
          "description": "One keyword, as typed into the search box."
        },
        "type": {
          "type": "string",
          "description": "Note type."
        },
        "post_id": {
          "type": "string",
          "description": "The shortcode of the comment's post."
        },
        "published_within": {
          "type": "string",
          "description": "Only posts from the last day, week, month or year."
        },
        "until": {
          "type": "string",
          "description": "Up to this date (YYYY-MM-DD)."
        },
        "window": {
          "type": "string",
          "description": "Look back this many days; 30 by default."
        },
        "since": {
          "type": "string",
          "description": "From this date (YYYY-MM-DD)."
        },
        "board": {
          "type": "string",
          "description": "Which list: hot searches is the only one."
        },
        "tab": {
          "type": "string",
          "description": "Which tab of the account's page: articles (the default), videos or pictures."
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Several IDs for one batch call; describe gives the most it takes."
        },
        "brand": {
          "type": "string",
          "description": "The brand name, spelled the way the Douyin index lists it."
        },
        "followers_max": {
          "type": "integer",
          "description": "At most this many followers."
        },
        "followers_min": {
          "type": "integer",
          "description": "At least this many followers."
        },
        "gender": {
          "type": "string",
          "description": "Only female or only male creators."
        },
        "lang": {
          "type": "string",
          "description": "Preferred transcript language. The result's lang is the track actually returned."
        },
        "media": {
          "type": "string",
          "description": "Only image or only video ads; all by default."
        },
        "search_by": {
          "type": "string",
          "description": "Match the words against what creators post (the default) or against their names."
        },
        "status": {
          "type": "string",
          "description": "Ads running now (the default), stopped ones, or both."
        },
        "advertiser": {
          "type": "string",
          "description": "The advertiser's name. Give query or advertiser. (one capability takes it)"
        },
        "category": {
          "type": "string",
          "description": "Only notes of this content category, as written in the creator detail’s categories. A category that does not exist finds nothing. (one capability takes it)"
        },
        "domain": {
          "type": "string",
          "description": "The brand's website domain. Give id or domain. (one capability takes it)"
        },
        "duration": {
          "type": "string",
          "description": "Only videos of this length. (one capability takes it)"
        },
        "engagement_min": {
          "type": "integer",
          "description": "Engagement rate of the last 30 days at least this, in percent: 3 means 3%. (one capability takes it)"
        },
        "feature_tag": {
          "type": "string",
          "description": "Only notes with this content feature tag, as written in the creator detail’s ext.feature_tags. A tag that does not exist finds nothing. (one capability takes it)"
        },
        "filter": {
          "type": "string",
          "description": "Only verified accounts, or only those live now. (one capability takes it)"
        },
        "format": {
          "type": "string",
          "description": "Only text, image or video ads; all by default. (one capability takes it)"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "One to five keywords, each without a comma. Give keyword or keywords. (one capability takes it)"
        },
        "name": {
          "type": "string",
          "description": "The advertiser's name as on its Facebook page. Give id or name. (one capability takes it)"
        },
        "traffic": {
          "type": "string",
          "description": "Which traffic the reads count: all, promoted traffic included (the default), or organic traffic alone. Likes and saves stay the same. (one capability takes it)"
        },
        "view": {
          "type": "string",
          "enum": [
            "compact",
            "standard",
            "full"
          ],
          "description": "How much of each object: compact leaves out empty fields, standard keeps them, full adds platform extras under ext. compact when left out."
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 50,
          "description": "Keep only these fields, by dotted path (author.name), to save tokens."
        },
        "max_price": {
          "type": "string",
          "pattern": "^\\d{1,7}(\\.\\d{1,6})?$",
          "description": "The most this call may cost, in US dollars as text, e.g. \"0.05\". A call that could cost more is refused and not charged."
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "Optional. A new unique value (a UUID) lets you resend a call whose answer did not arrive: the same value returns the first result, charged once."
        }
      },
      "required": [
        "capability"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "Call a capability",
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "read_more",
    "title": "Read the rest of a result",
    "description": "The rest of an answer call cut to fit, or the whole result in another view or with other fields. Free: nothing is fetched again. Results are kept 24 hours and read with the key's account that made the call.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "result_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "The result ID call printed."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Where to go on, as the cut notice printed it; 0 or left out: from the start."
        },
        "view": {
          "type": "string",
          "enum": [
            "compact",
            "standard",
            "full"
          ],
          "description": "How much of each object: compact leaves out empty fields, standard keeps them, full adds platform extras under ext. The call's own view when left out."
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 50,
          "description": "Keep only these fields, by dotted path (author.name), to save tokens."
        }
      },
      "required": [
        "result_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "Read the rest of a result",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "account",
    "title": "Account, receipts, usage and status",
    "description": "balance: the balance, the key's spending limits and what it spent. receipt: what one call was charged (request_id). usage: calls and charges by day, capability, key_id, entry, source or end_user (since, until, group_by). status: which capabilities are up, no key needed. Free.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "what": {
          "type": "string",
          "enum": [
            "balance",
            "receipt",
            "usage",
            "status"
          ],
          "description": "balance with a key, status without one, when left out."
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "For receipt: the call's request ID (its result ID)."
        },
        "since": {
          "type": "string",
          "maxLength": 40,
          "description": "For usage: from this date (YYYY-MM-DD) or ISO time; 30 days back when left out."
        },
        "until": {
          "type": "string",
          "maxLength": 40,
          "description": "For usage: up to this date (the whole day) or ISO time; now when left out."
        },
        "group_by": {
          "type": "string",
          "maxLength": 80,
          "description": "For usage: day, capability, key_id, entry, source, end_user, comma-separated; day when left out."
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "title": "Account, receipts, usage and status",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  }
]
