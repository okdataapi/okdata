[
  {
    "name": "find",
    "title": "Find a capability",
    "description": "Find the capability for a need described in plain words, English or Chinese, among 214 on 17 platforms: up to 5, best first, each with what it needs, its price and a ready call. With a platform and no match it lists everything that platform has; never use another platform's capability in its place. Free, no key.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "maxLength": 200,
          "description": "What is needed, in words, e.g. \"小红书笔记评论\" or \"comments under a TikTok video\"."
        },
        "platform": {
          "type": "string",
          "maxLength": 40,
          "description": "A platform ID or name (douyin, xiaohongshu, wechat_mp, bilibili, weibo, tiktok, x, youtube, meta, google, instagram, reddit, kuaishou, zhihu, wechat_channels, wechat, telegram). Alone, it lists everything the platform has."
        },
        "category": {
          "type": "string",
          "enum": [
            "ads",
            "commerce",
            "creator",
            "social"
          ],
          "description": "Only capabilities of this kind."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "How many matches, 5 when left out."
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "title": "Find a capability",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "describe",
    "title": "Describe capabilities",
    "description": "The contract of 1 to 5 capabilities: each parameter with its meaning and an example, the links url takes, price and the most one call can cost, paging, the fields returned, what the platform cannot give, an example call and an example item with its size. Free, no key. Use it when unsure of a parameter.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 1,
          "maxItems": 5,
          "description": "Capability IDs, e.g. [\"x.trends.list\"]."
        }
      },
      "required": [
        "ids"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "Describe capabilities",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
