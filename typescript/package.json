{
  "name": "@okdata/sdk",
  "version": "0.1.1",
  "description": "TypeScript SDK for okdata, the social data API and MCP server for AI agents: TikTok, RedNote (Xiaohongshu), Douyin, WeChat, X, YouTube, Bilibili, Weibo and more, paid per call. One typed method per endpoint, safe retries, paging with a spend limit. No runtime dependencies.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": {
    "node": ">=20.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "okdata",
    "sdk",
    "social media api",
    "social data",
    "ai agents",
    "mcp",
    "douyin",
    "xiaohongshu",
    "rednote",
    "wechat",
    "bilibili",
    "weibo",
    "tiktok",
    "twitter",
    "x",
    "youtube",
    "instagram",
    "reddit",
    "kuaishou",
    "douyin api",
    "xiaohongshu api",
    "tiktok api",
    "xingtu",
    "wechat official account",
    "mcp server",
    "claude",
    "cursor",
    "social media data",
    "typescript"
  ],
  "homepage": "https://okdata.online/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okdataapi/okdata.git",
    "directory": "typescript"
  },
  "bugs": "https://github.com/okdataapi/okdata/issues",
  "license": "MIT",
  "author": "okdata <hello@okdata.online>",
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
