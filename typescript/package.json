{
  "name": "@okdata/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for okdata: social data from Douyin, Xiaohongshu, WeChat, Bilibili, Weibo, TikTok, X, YouTube and more, for AI agents, paid per call. One typed method per endpoint, safe retries, paging with a spend limit. No runtime dependencies.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "okdata",
    "sdk",
    "social media api",
    "social data",
    "ai agents",
    "mcp",
    "douyin",
    "xiaohongshu",
    "rednote",
    "wechat",
    "bilibili",
    "weibo",
    "tiktok",
    "twitter",
    "x",
    "youtube",
    "instagram",
    "reddit"
  ],
  "homepage": "https://okdata.online/docs/sdk/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okdataapi/okdata.git",
    "directory": "typescript"
  },
  "bugs": "https://github.com/okdataapi/okdata/issues",
  "license": "MIT",
  "author": "okdata <hello@okdata.online>",
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
