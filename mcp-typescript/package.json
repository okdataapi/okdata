{
  "name": "@okdata/mcp",
  "version": "0.1.0",
  "description": "okdata MCP server over stdio, for Claude Desktop, Cursor and other local MCP clients: the social data API and MCP server for AI agents. TikTok, RedNote (Xiaohongshu), Douyin, WeChat, X, YouTube, Bilibili, Weibo and more, paid per call. Forwards to the hosted server at https://api.okdata.online/mcp.",
  "type": "module",
  "bin": {
    "okdata-mcp": "./dist/bin.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=18"
  },
  "mcpName": "online.okdata/mcp",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "mcp",
    "mcp server",
    "model context protocol",
    "stdio",
    "okdata",
    "social media api",
    "social data",
    "ai agents",
    "tiktok",
    "rednote",
    "xiaohongshu",
    "douyin",
    "wechat",
    "x",
    "twitter",
    "youtube",
    "instagram",
    "reddit",
    "bilibili",
    "weibo",
    "kuaishou",
    "tiktok mcp",
    "xiaohongshu mcp",
    "douyin mcp",
    "claude desktop",
    "claude code",
    "cursor"
  ],
  "homepage": "https://okdata.online/mcp/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okdataapi/okdata.git",
    "directory": "mcp-typescript"
  },
  "bugs": "https://github.com/okdataapi/okdata/issues",
  "license": "MIT",
  "author": "okdata <hello@okdata.online>",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
