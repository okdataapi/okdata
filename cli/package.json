{
  "name": "okdata",
  "version": "0.1.1",
  "description": "Command line for okdata, the social data API and MCP server for AI agents: TikTok, RedNote (Xiaohongshu), Douyin, WeChat, X, YouTube, Bilibili, Weibo and more, paid per call. Find and call endpoints, check your balance, log in from the terminal and set up the okdata MCP server in Claude Code, Cursor or Codex.",
  "type": "module",
  "bin": {
    "okdata": "./dist/bin.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=20.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "okdata",
    "cli",
    "command line",
    "social media api",
    "social data",
    "ai agents",
    "mcp",
    "douyin",
    "xiaohongshu",
    "rednote",
    "wechat",
    "bilibili",
    "weibo",
    "tiktok",
    "twitter",
    "x",
    "youtube",
    "instagram",
    "reddit",
    "kuaishou",
    "douyin api",
    "xiaohongshu api",
    "tiktok api",
    "xingtu",
    "wechat official account",
    "mcp server",
    "claude",
    "claude code",
    "cursor",
    "codex",
    "social media data"
  ],
  "homepage": "https://okdata.online/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okdataapi/okdata.git",
    "directory": "cli"
  },
  "bugs": "https://github.com/okdataapi/okdata/issues",
  "license": "MIT",
  "author": "okdata <hello@okdata.online>",
  "dependencies": {
    "@okdata/sdk": "^0.1.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
